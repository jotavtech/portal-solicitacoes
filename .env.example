# Copie para .env na raiz. Todos os comandos são executados nessa raiz.
NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/portal.sqlite
APP_TIMEZONE=America/Sao_Paulo
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
VITE_APP_TIMEZONE=America/Sao_Paulo
# true somente com reverse proxy local confiável; API escuta no loopback.
TRUST_PROXY_LOOPBACK=false
# Produção exige COOKIE_SECURE=true e HTTPS.
# Seed só com opt-in ou npm run db:seed; não é executado no startup.
DEMO_SEED_ENABLED=false
