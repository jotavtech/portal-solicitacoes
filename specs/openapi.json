  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "portal.sid",
        "description": "Token opaco HttpOnly, SameSite=Lax, Secure em produção; sessão persistida e validada no servidor."
      }
    },
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "TI",
          "RH",
          "COMPRAS",
          "FINANCEIRO",
          "INFRAESTRUTURA"
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "ABERTO",
          "EM_ATENDIMENTO",
          "CONCLUIDO"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "name"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/User"
              },
              {
                "type": "null"
              }
            ]
          },
          "csrfToken": {
            "type": "string",
            "minLength": 32
          }
        },
        "required": [
          "user",
          "csrfToken"
        ]
      },
      "AuthenticatedSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "csrfToken": {
            "type": "string",
            "minLength": 32
          }
        },
        "required": [
          "user",
          "csrfToken"
        ]
      },
      "LoginInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "description": "Normalizado para minúsculas no servidor."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Não aparar nem normalizar."
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "RequestInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "description": "Aparar antes de validar; limites em pontos de código Unicode."
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 5000,
            "description": "Aparar antes de validar; renderizar como texto."
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          }
        },
        "required": [
          "title",
          "description",
          "category"
        ]
      },
      "StatusInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "status"
        ]
      },
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "requester": {
            "$ref": "#/components/schemas/User"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "category",
          "requester",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "RequestPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Request"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ]
      },
      "Dashboard": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "open": {
            "type": "integer",
            "minimum": 0
          },
          "inProgress": {
            "type": "integer",
            "minimum": 0
          },
          "completed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "total",
          "open",
          "inProgress",
          "completed"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
