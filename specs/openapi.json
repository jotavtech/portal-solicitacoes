        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32
            },
            "description": "Token da sessão atual obtido em /auth/session; substituir após login."
          }
        ]
